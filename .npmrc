# Shai-Hulud supply-chain hardening — 7d package age cooldown
min-release-age=7
minimum-release-age=10080

# Shai-Hulud supply-chain hardening: block lifecycle scripts at install time.
# This repo has no native deps that need install hooks today.
# If one is added (sharp, esbuild CLI, node-gyp, puppeteer, etc.), allowlist
# via pnpm.onlyBuiltDependencies in package.json (pnpm 10+) or via
# `npm rebuild <pkg>` after install (npm).
ignore-scripts=true
